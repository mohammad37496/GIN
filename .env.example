# Liara PostgreSQL connection string (set SSL options as required by your database)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-bytes
APP_URL=https://your-domain.example

# Optional one-time admin bootstrap (remove after first successful startup)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# S3-compatible Liara Object Storage
S3_ENDPOINT=https://storage.iran.liara.space
S3_REGION=default
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key

# Optional public base URL/CDN for uploaded assets
S3_PUBLIC_URL=
